# SmartBot Cache v4.0 — Production Configuration
# ✅ ตั้งค่า API Keys และ Server Configuration

# ── API Keys (เลือกอย่างน้อย 1 ตัว) ─────────────────────────────────
# Gemini (ฟรี 1,500/วัน) - แนะนำเริ่มต้น
# ได้จาก: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=

# DeepSeek ($0.28/M tokens) - optional
# ได้จาก: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Claude Sonnet ($3/M tokens) - optional  
# ได้จาก: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# ── Server ────────────────────────────────────────────────────────
PORT=3000

# ── Cache Configuration ───────────────────────────────────────────
# TTL: how long to keep cached responses (ms)
CACHE_TTL_MS=3600000
# Maximum number of cached entries
MAX_CACHE=10000
# Semantic similarity threshold (0.0-1.0)
SEM_THRESH=0.72

# ── Security ──────────────────────────────────────────────────────
# Maximum request body size in KB
MAX_BODY_KB=32
# Rate limit: requests per window
RATE_LIMIT=300
# Rate limit window in ms
RATE_WINDOW=60000

# ── Performance ───────────────────────────────────────────────────
# Timeout per model call in ms
MODEL_TIMEOUT=15000
# Logging level: info | debug | error
LOG_LEVEL=info
